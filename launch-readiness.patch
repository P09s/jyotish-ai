+# ── Required ──────────────────────────────────────────────────────────────
+
+# Supabase project (auth + database). From your Supabase project settings.
+NEXT_PUBLIC_SUPABASE_URL=
+NEXT_PUBLIC_SUPABASE_ANON_KEY=
+
+# Groq API key — powers chat, bhavishya-fal, and other LLM-backed features.
+# Free tier: https://console.groq.com/keys
+GROQ_API_KEY=
+
+
+# ── Optional features (app runs fine without these; the related feature
+#    is just disabled/inert until you set them) ────────────────────────────
+
+# Hugging Face token — only needed if NEXT_PUBLIC_SPOUSE_PORTRAIT_ENABLED=true.
+# Free tier token with "Inference Providers" permission:
+# https://huggingface.co/settings/tokens
+HF_TOKEN=
+
+# Feature flag — Spouse Portrait is fully built but paused until there's
+# budget for image-gen credits (HF's free tier covers ~3 generations/month
+# total, shared across every user — not enough for public traffic). Leave
+# unset/false until ready; see conversation history for context.
+NEXT_PUBLIC_SPOUSE_PORTRAIT_ENABLED=false
+
+# Sentry error monitoring — leave unset and the app runs with no monitoring
+# (errors only show up in server logs). Set this to start reporting caught
+# errors from app/error.tsx and app/global-error.tsx.
+NEXT_PUBLIC_SENTRY_DSN=
+SENTRY_ORG=
+SENTRY_PROJECT=
+
+# Upstash Redis — leave unset and rate limiting falls back to an in-memory
+# limiter (works, but resets per server instance and isn't shared across
+# multiple concurrent instances). Set both to make rate limits global.
+# Free tier: https://console.upstash.com
+UPSTASH_REDIS_REST_URL=
+UPSTASH_REDIS_REST_TOKEN=
